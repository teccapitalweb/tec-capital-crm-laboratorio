{
  "name": "tec-capital-crm-laboratorio",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio multicanal de TEC Capital con perfiles, conversaciones persistentes y WebSocket.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node scripts/demo-local.mjs",
    "demo:reset": "node scripts/demo-local.mjs --reset",
    "check": "node scripts/check.mjs",
    "check:syntax": "node scripts/check.mjs syntax"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "lucide": "1.65.0",
    "ws": "8.22.0"
