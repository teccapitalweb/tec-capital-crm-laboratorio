PORT=3100
HOST=127.0.0.1
DATA_DIR=./data
# Set long random values before exposing the server. Never commit real values.
STAFF_INVITE_CODE=
ADMIN_INVITE_CODE=
# Set the HTTPS origin in production, for example https://your-domain.example
APP_ORIGIN=
NODE_ENV=development

# Proveedor de IA para el nivel «autónomo» de respuestas (opcional). Vacío = simulador local sin costo.
# AI_PROVIDER=claude
# AI_MODEL=claude-sonnet-5-5
# Topes mensuales de gasto de la IA (0 = sin tope). Al alcanzarlos deja de llamar y responde una persona.
# Página pública de postulación de aliados (/aliados): apagada por omisión; enciéndela sólo con aviso de privacidad revisado.
# ALLY_FORM_ENABLED=1
# AI_SUMMARY_MODEL=claude-haiku-5-5   # modelo económico para resumir conversaciones
# AI_KB_TOP_K=6
# AI_MONTHLY_CALL_LIMIT=1000
# AI_MONTHLY_TOKEN_LIMIT=0
# ANTHROPIC_API_KEY=

# Simulador de clientes (Operación → Demo). Ponlo en 1 para ocultarlo en un entorno con clientes reales.
# SIMULATOR_DISABLED=1

# Modo presentación: tarifas orientativas por mensaje saliente (MXN) para el costo estimado. Nunca es una factura.
# MESSAGE_RATES=marketing=0.80,utility=0.16,service=0

# Aviso de privacidad publico en /privacidad (docs/PLAN_AVISO_PRIVACIDAD.md): nombre de la empresa y correo para solicitudes de privacidad.
# PRIVACY_COMPANY=TEC Capital
# PRIVACY_CONTACT_EMAIL=

# Conectores (docs/CONECTORES.md). Por omisión todo es simulado y nada sale a internet.
# CHANNEL_CONNECTOR=simulated        # simulated | meta
# PAYMENT_CONNECTOR=simulated        # simulated | stripe | conekta
# CONNECTOR_WEBHOOK_SECRET=          # firma HMAC de los webhooks de prueba del simulado y del botón «Probar webhook»
# WhatsApp real (docs/ACTIVAR_WHATSAPP_REAL.md): con CHANNEL_CONNECTOR=meta hacen falta las cuatro primeras; una variable por dato.
# META_ACCESS_TOKEN= META_APP_SECRET= META_VERIFY_TOKEN= META_PHONE_NUMBER_ID= META_WABA_ID= META_PAGE_ID= META_IG_ACCOUNT_ID=
# META_GRAPH_VERSION=v25.0           # opcional: versión de la API de Meta
# WA_HOLD_DAYS=7                     # días que un aviso espera la respuesta de la persona antes de caducar (docs/PLAN_PLANTILLAS_WHATSAPP.md)
# META_APP_ID=                      # identificador de la app de Meta (no es secreto): subir la muestra de una plantilla con imagen o PDF (docs/PLAN_PLANTILLAS_COMPLETAS.md)
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=
# CONEKTA_PRIVATE_KEY= CONEKTA_WEBHOOK_SECRET=
# Recepción duradera, envío en duda y apagado ordenado (docs/PLAN_RECEPCION_DURADERA.md)
# WEBHOOK_INBOX_WAIT_MS=3000         # cuánto espera un webhook a que sus eventos terminen para devolver su resultado; 0 = responder en cuanto se guardan
# WA_UNCERTAIN_SEND=retry            # envío de WhatsApp cuyo resultado se desconoce porque el servidor murió con él en vuelo: retry | fail
# SHUTDOWN_GRACE_MS=1500             # cuánto espera el apagado a lo que está en vuelo; en producción se recomienda 10000

# Notificaciones push del equipo (docs/PLAN_PUSH.md). Opt-in por dispositivo; la única salida real a internet.
# PUSH_DISABLED=1                    # apaga las notificaciones push en este entorno
# PUSH_DELAY_MS=15000                # espera antes de enviar un aviso no leído
# PUSH_SUBJECT=https://tu-dominio.example   # contacto de la firma VAPID (URL https o mailto: del equipo)

# Núcleo compartido (docs/NUCLEO.md). Sin CORE_SINK_URL el outbox es simulado y nada sale del servidor.
# CORE_SINK_URL=                     # https://… del receptor del núcleo (Supabase Edge Function o servicio de la Academia)
# CORE_SINK_SECRET=                  # secreto HMAC compartido con el receptor; firma X-Nucleo-Signature sobre «timestamp.cuerpo»

# API pública y webhooks (docs/PLAN_API_PUBLICA.md)
# WEBHOOK_ALLOW_PRIVATE=1            # SÓLO laboratorio/pruebas: permite webhooks salientes a http y a direcciones locales. No activar en producción (docs/PLAN_API_PUBLICA.md)

# Dirección real de quien visita (límites de intentos por dirección). Detrás de un proxy, la dirección que ve el
# servidor es la del proxy; con TRUSTED_PROXY_HOPS se lee la que añadió el proxy propio. Ver docs/OPERACION_Y_PRUEBAS.md.
# TRUSTED_PROXY_HOPS=1               # proxies PROPIOS delante del servidor (Railway: 1). Sin definir: no se confía en ninguna cabecera
# TRUSTED_PROXY_CIDRS=               # opcional: rangos desde los que se acepta la cabecera (10.0.0.0/8, …)
# LOG_CLIENT_ADDRESS=1               # sólo para comprobarlo: cada petición a /api/health anota qué llegó y qué se resolvió
